# Vodia Bot - Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.

VODIA_HOST=your-vodia-host.example.com
VODIA_USER=your-vodia-username
VODIA_PASS=your-vodia-password
VODIA_BASE_URL=https://your-vodia-host.example.com/rest/
BOT_PORT=8000
BOT_HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO
