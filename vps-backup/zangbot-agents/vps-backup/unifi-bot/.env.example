# UniFi Bot - Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.

# UniFi Site Manager API (cloud)
UNIFI_API_BASE_URL=https://api.ui.com
UNIFI_API_KEY=your-unifi-cloud-api-key

# UniFi Local Network API
UNIFI_LOCAL_CONTROLLER_URL=https://your-controller-ip
UNIFI_USERNAME=your-unifi-username
UNIFI_PASSWORD=your-unifi-password

# Local LLM (Ollama or compatible)
NEMO_ENDPOINT=http://localhost:1234/v1
NEMO_MODEL=your-model-name

# Bot Service
BOT_PORT=8000
BOT_LOG_FILE=/opt/unifi-bot/bot.log
